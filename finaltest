# YOLO 예측 결과 이미지 저장
import os
from glob import glob
from ultralytics import YOLO
import cv2

# ✅ 학습된 모델 경로 (.pt)
model_path = r"C:\Users\user\Desktop\abcd-a\runs\segment\train2\weights\best.pt"
model = YOLO(model_path)

# ✅ 예측할 이미지 폴더 (원본 이미지들이 있는 경로)
input_folder = r"C:\Users\user\Desktop\abcd-a\dataset\train\images"

# ✅ 예측 결과 저장할 폴더
output_folder = r"C:\Users\user\Desktop\abcd-a\yolo_outputs"
os.makedirs(output_folder, exist_ok=True)

# ✅ 이미지 파일 목록 불러오기
image_paths = sorted(glob(os.path.join(input_folder, '*.jpg')) + glob(os.path.join(input_folder, '*.png')))

# ✅ 이미지별 예측하고 저장
for img_path in image_paths:
    results = model(img_path)  # 예측
    labeled_img = results[0].plot()  # 시각화
    filename = os.path.basename(img_path)
    save_path = os.path.join(output_folder, filename)
    cv2.imwrite(save_path, labeled_img)

print(f"✅ 총 {len(image_paths)}장의 예측 이미지 저장 완료: {output_folder}")

# YOLO 예측 결과 이미지들을 영상으로 변환
import cv2
import os
from glob import glob

# ✅ 위에서 저장한 예측 이미지 폴더
img_folder = r"C:\Users\user\Desktop\abcd-a\yolo_outputs"
# ✅ 저장할 영상 경로
output_video = r"C:\Users\user\Desktop\abcd-a\yolo_outputs_video.mp4"


# ✅ 이미지 파일 목록 불러오기
img_files = sorted(glob(os.path.join(img_folder, '*.jpg')) + glob(os.path.join(img_folder, '*.png')))
if not img_files:
    print(f"❌ 이미지가 없습니다: {img_folder}")
else:
    # 첫 이미지로 사이즈 설정
    frame = cv2.imread(img_files[0])
    height, width, _ = frame.shape

    # 영상 설정 (FPS 5)
    video = cv2.VideoWriter(output_video, cv2.VideoWriter_fourcc(*'mp4v'), 5, (width, height))

    for img_path in img_files:
        frame = cv2.imread(img_path)
        video.write(frame)

    video.release()
    print(f"✅ 비디오 저장 완료: {output_video}")
